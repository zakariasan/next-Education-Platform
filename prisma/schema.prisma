// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

//datasource db {
//  provider = "sqlite"
//  url      = env("DATABASE_URL")
//}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum LessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED // Optional: for soft deletion or old versions
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// Gamified project-based learning (see docs/gamification.md)
enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CriterionMode {
  AUTO
  TEACHER
  PEER
}

enum AttemptState {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  VALIDATED
  FAILED
}

enum ReviewKind {
  TEACHER
  PEER
}

enum ReviewStatus {
  PENDING
  DONE
}

enum XpReason {
  PROJECT_VALIDATED
  SPEED_BONUS
  RETRY_PENALTY
  PEER_REVIEW
  BADGE
}

enum ExerciseType {
  YES_NO
  CHECK_TEST
}

enum MessageStatus {
  PENDING
  ACCEPTED
}

enum EventScope {
  GLOBAL
  SCHOOL
  CLASS
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum MaterialFormat {
  DOCUMENT
  LATEX
}

enum CompileStatus {
  NONE
  PENDING
  SUCCESS
  FAILED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  avatar    String? // For avatar (from Google or custom upload)
  provider  String? // "credentials" or "google"
  role      Role?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // XP totals
  totalXP Int @default(0)

  //relations
  teacherClasses   Class[]  @relation("teacherClasses")
  studentClasses   Class[]  @relation("studentClasses")
  quizzes          Quiz[]   @relation("teacherQuizzes")
  submittedQuizzes Quiz[]   @relation("studentQuizzes")
  lessons          Lesson[] @relation("teacherLessons")

  // Seance participation
  participations SeanceParticipation[]

  //Exam
  exams       Exam[]       @relation("TeacherExams") // 👈 exams this teacher created
  results     ExamResult[]
  examRatings ExamRating[]

  // Schools
  ownedSchools      School[]        @relation("SchoolCreator")
  schoolMemberships SchoolTeacher[]

  // Class enrollment metadata (ban tracking etc.)
  enrollments ClassEnrollment[]

  // Gamification: modules, projects, attempts, reviews, XP, badges
  correctionPoints  Int                @default(0)
  modules           Module[]           @relation("TeacherModules")
  projectsCreated   Project[]          @relation("TeacherProjects")
  projectAttempts   ProjectAttempt[]   @relation("AttemptStudent")
  reviewedAttempts  ProjectAttempt[]   @relation("AttemptReviewer")
  gradedCriteria    CriterionScore[]   @relation("CriterionGrader")
  reviewAssignments ReviewAssignment[] @relation("ReviewAssignee")
  xpEvents          XpEvent[]
  badges            UserBadge[]

  // Exercises
  exerciseSubmissions ExerciseSubmission[]

  // Messaging
  sentMessages     Message[] @relation("StudentMessages")
  receivedMessages Message[] @relation("TeacherMessages")

  // Events
  eventsCreated Event[]
}

model Class {
  id          String  @id @default(cuid())
  name        String
  description String?
  key         String  @unique

  teacherId String
  teacher   User   @relation("teacherClasses", fields: [teacherId], references: [id])
  students  User[] @relation("studentClasses")

  // Nullable in the DB (see prisma/backfill-schools.ts) even though every
  // class is meant to belong to a school going forward; this project uses
  // `prisma db push` against a live DB with existing rows, so the column
  // can't be pushed as required without a backfill pass first. Enforce
  // "school required" at the application layer for new classes.
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  lessons     Lesson[]
  quizzes     Quiz[]
  materials   Materials[]
  seances     Seance[]
  exams       Exam[]
  enrollments ClassEnrollment[]
  exercises   Exercise[]
  events      Event[]
  messages    Message[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Lesson {
  id          String  @id @default(cuid())
  title       String
  description String?

  content String? // Store lesson content (HTML or JSON from editor)
  status  LessonStatus @default(DRAFT) // New: draft or published

  teacher   User   @relation("teacherLessons", fields: [teacherId], references: [id])
  teacherId String

  class     Class       @relation(fields: [classId], references: [id])
  classId   String
  materials Materials[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Quiz {
  id        String @id @default(cuid())
  title     String
  teacherId String // This connects to a teacher
  teacher   User   @relation("teacherQuizzes", fields: [teacherId], references: [id])
  class     Class  @relation(fields: [classId], references: [id])
  classId   String

  dueDate     DateTime?
  duration    Int? // in minutes
  submissions User[]    @relation("studentQuizzes")

  questions Question[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Question {
  id        String   @id @default(cuid())
  text      String
  imageUrl  String? // Optional image
  answers   Answer[] // List of options
  correct   Int // Index of correct answer in answers[]
  quiz      Quiz     @relation(fields: [quizId], references: [id])
  quizId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Answer {
  id         String   @id @default(cuid())
  text       String
  index      Int
  question   Question @relation(fields: [questionId], references: [id])
  questionId String
}

model Materials {
  id        String   @id @default(cuid())
  name      String
  fileUrl   String
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  lessonId  String
  createdAt DateTime @default(now())
  Class     Class?   @relation(fields: [classId], references: [id])
  classId   String?

  // LaTeX source support (see ExamFile for the same pattern).
  format        MaterialFormat @default(DOCUMENT)
  sourceContent String?
  compileStatus CompileStatus  @default(NONE)
  compiledUrl   String?
}

// A teaching session / meeting
model Seance {
  id       String    @id @default(cuid())
  title    String?
  startsAt DateTime  @default(now())
  endsAt   DateTime?
  isActive Boolean   @default(false)

  class   Class  @relation(fields: [classId], references: [id])
  classId String

  participations SeanceParticipation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Attendance + points per student in a seance
model SeanceParticipation {
  id        String @id @default(cuid())
  seanceId  String
  studentId String

  attendance AttendanceStatus @default(PRESENT)
  points     Int              @default(0)
  notes      String?
  seance     Seance           @relation(fields: [seanceId], references: [id], onDelete: Cascade)
  student    User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seanceId, studentId]) // One record per student per seance
}

// feature of Exam 
// prisma/schema.prisma

enum ExamType {
  MIDTERM
  FINAL
  LOCAL
  CUSTOM
}

enum ExamFileKind {
  STATEMENT
  CORRECTION
  RUBRIC
  OTHER
}

model Exam {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        ExamType
  date        DateTime?
  class       Class     @relation(fields: [classId], references: [id])
  classId     String
  teacher     User      @relation("TeacherExams", fields: [teacherId], references: [id])
  teacherId   String
  maxScore    Int       @default(20) // the grading base (e.g., 20 or 100)
  maxXP       Int       @default(100) // how many XP at 100% score

  files   ExamFile[]
  results ExamResult[]
  ratings ExamRating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExamFile {
  id     String       @id @default(cuid())
  exam   Exam         @relation(fields: [examId], references: [id])
  examId String
  name   String
  url    String
  kind   ExamFileKind @default(OTHER)

  // LaTeX source support: if format=LATEX, url/sourceContent holds the
  // .tex source and compiledUrl is populated once compiled successfully.
  // A FAILED compileStatus means nothing gets shown to students.
  format        MaterialFormat @default(DOCUMENT)
  sourceContent String?
  compileStatus CompileStatus  @default(NONE)
  compiledUrl   String?

  createdAt DateTime @default(now())
}

model ExamResult {
  id        String @id @default(cuid())
  exam      Exam   @relation(fields: [examId], references: [id])
  examId    String
  student   User   @relation(fields: [studentId], references: [id])
  studentId String

  score     Float   @default(0) // raw exam score
  xpAwarded Int     @default(0) // computed from score/maxScore * maxXP
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, studentId]) // one row per student per exam
}

model ExamRating {
  id        String @id @default(cuid())
  exam      Exam   @relation(fields: [examId], references: [id])
  examId    String
  student   User   @relation(fields: [studentId], references: [id])
  studentId String

  difficulty Difficulty
  feedback   String?

  createdAt DateTime @default(now())

  @@unique([examId, studentId])
}

// feature of Schools

model School {
  id          String  @id @default(cuid())
  name        String
  description String?

  createdBy   User   @relation("SchoolCreator", fields: [createdById], references: [id])
  createdById String

  teachers SchoolTeacher[]
  classes  Class[]
  events   Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SchoolTeacher {
  id String @id @default(cuid())

  school    School @relation(fields: [schoolId], references: [id])
  schoolId  String
  teacher   User   @relation(fields: [teacherId], references: [id])
  teacherId String

  createdAt DateTime @default(now())

  @@unique([schoolId, teacherId])
}

// Enrollment metadata on top of the existing Class.students m2m
// (kept additive so join-class/leaderboard/progress/g-attendance keep working).
model ClassEnrollment {
  id String @id @default(cuid())

  class     Class  @relation(fields: [classId], references: [id])
  classId   String
  student   User   @relation(fields: [studentId], references: [id])
  studentId String

  banned       Boolean   @default(false)
  bannedAt     DateTime?
  bannedReason String?

  // Consecutive-presence streak for the attendance XP bonus (1 XP per
  // present seance, +50 XP bonus every time the streak hits the threshold).
  // Bumped/reset by the seance-attendance API (later phase); reset to 0 on
  // any non-PRESENT attendance.
  presentStreak Int @default(0)

  joinedAt DateTime @default(now())

  @@unique([classId, studentId])
}

// ---------------------------------------------------------------------------
// Gamified project-based learning ("Holy Graph"). See docs/gamification.md.
// ---------------------------------------------------------------------------

// A subject track owned by a teacher (e.g. "Physics – Mechanics"). Visible to
// every student enrolled in one of that teacher's classes.
model Module {
  id          String        @id @default(cuid())
  title       String
  description String?
  subject     String        @default("Physics")
  status      ProjectStatus @default(DRAFT)

  teacher   User   @relation("TeacherModules", fields: [teacherId], references: [id])
  teacherId String

  projects Project[]
  xpEvents XpEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Project identity: graph node. Editable content lives in ProjectVersion so
// that published edits create a new version while old attempts stay linked.
model Project {
  id String @id @default(cuid())

  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId String

  teacher   User   @relation("TeacherProjects", fields: [teacherId], references: [id])
  teacherId String

  isCore     Boolean       @default(true)
  orderIndex Int           @default(0)
  status     ProjectStatus @default(DRAFT)

  // Teacher-pinned Holy Graph position (unit coordinates); null = auto layout.
  pinX Float?
  pinY Float?

  currentVersion   ProjectVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  currentVersionId String?         @unique
  versions         ProjectVersion[] @relation("ProjectVersions")

  // Prerequisite edges (prerequisite -> this project)
  prerequisites Project[] @relation("ProjectPrerequisites")
  dependents    Project[] @relation("ProjectPrerequisites")

  attempts ProjectAttempt[]
  xpEvents XpEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
}

model ProjectVersion {
  id            String  @id @default(cuid())
  project       Project @relation("ProjectVersions", fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  versionNumber Int

  title            String
  statement        String // markdown with $LaTeX$
  objectives       Json // string[]
  estimatedHours   Float
  xpReward         Int
  allowedResources Json // string[]
  threshold        Int    @default(70) // weighted % needed to validate

  criteria RubricCriterion[]
  attempts ProjectAttempt[]

  currentOf Project? @relation("CurrentVersion")

  createdAt DateTime @default(now())

  @@unique([projectId, versionNumber])
}

model RubricCriterion {
  id        String         @id @default(cuid())
  version   ProjectVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId String

  title       String
  description String?
  weight      Int
  mode        CriterionMode
  orderIndex  Int           @default(0)

  // AUTO grading config:
  //   { type: "NUMERIC", answer: number, tolerance: number, unit?: string }
  //   { type: "MCQ", choices: string[], correctIndexes: number[] }
  //   { type: "UNIT", expectedUnit: string }
  autoConfig Json?

  scores CriterionScore[]
}

model ProjectAttempt {
  id String @id @default(cuid())

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  version   ProjectVersion @relation(fields: [versionId], references: [id])
  versionId String
  student   User           @relation("AttemptStudent", fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  attemptNumber Int          @default(1)
  state         AttemptState @default(NOT_STARTED)

  startedAt   DateTime?
  submittedAt DateTime?
  reviewedAt  DateTime?
  actualHours Float?

  answers  Json? // { [criterionId]: unknown }
  score    Float? // weighted %, 0..100
  feedback String?

  reviewer   User?   @relation("AttemptReviewer", fields: [reviewerId], references: [id])
  reviewerId String?

  xpAwarded Int @default(0)

  criterionScores CriterionScore[]
  reviews         ReviewAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, studentId, attemptNumber])
  @@index([studentId])
  @@index([state])
}

model CriterionScore {
  id          String          @id @default(cuid())
  attempt     ProjectAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId   String
  criterion   RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  criterionId String

  score       Float // 0..100
  mode        CriterionMode
  grader      User?   @relation("CriterionGrader", fields: [graderId], references: [id])
  graderId    String?
  comment     String?
  spotChecked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, criterionId])
}

model ReviewAssignment {
  id         String         @id @default(cuid())
  attempt    ProjectAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId  String
  reviewer   User           @relation("ReviewAssignee", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerId String

  kind        ReviewKind
  status      ReviewStatus @default(PENDING)
  spotChecked Boolean      @default(false)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([attemptId, reviewerId])
  @@index([reviewerId, status])
}

// Append-only XP ledger. User.totalXP is kept in sync for the existing
// leaderboard/attendance code. dedupeKey guarantees XP is awarded once per
// (student, project) regardless of attempt count.
model XpEvent {
  id     String   @id @default(cuid())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  amount Int
  reason XpReason

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?
  module    Module?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  moduleId  String?
  attemptId String?

  dedupeKey String? @unique

  createdAt DateTime @default(now())

  @@index([userId, moduleId])
}

model Badge {
  id          String @id @default(cuid())
  code        String @unique
  title       String
  description String
  icon        String // lucide icon name

  users UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  badgeId   String
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model Exercise {
  id      String       @id @default(cuid())
  class   Class        @relation(fields: [classId], references: [id])
  classId String
  topic   String
  type    ExerciseType

  question String

  // used when type=YES_NO
  correctAnswer Boolean?
  // used when type=CHECK_TEST: { choices: string[], correctIndexes: number[] }
  options       Json?

  xpReward Int @default(0)

  submissions ExerciseSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExerciseSubmission {
  id         String   @id @default(cuid())
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  exerciseId String
  student    User     @relation(fields: [studentId], references: [id])
  studentId  String

  passed    Boolean
  xpAwarded Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([exerciseId, studentId])
}

model Message {
  id      String  @id @default(cuid())
  class   Class?  @relation(fields: [classId], references: [id])
  classId String?

  sender    User   @relation("StudentMessages", fields: [senderId], references: [id])
  senderId  String
  teacher   User   @relation("TeacherMessages", fields: [teacherId], references: [id])
  teacherId String

  content String
  status  MessageStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String     @id @default(cuid())
  title       String
  description String?
  date        DateTime
  scope       EventScope @default(CLASS)

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])
  classId  String?
  class    Class?  @relation(fields: [classId], references: [id])

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
